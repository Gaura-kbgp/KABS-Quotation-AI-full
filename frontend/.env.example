# === Genkit & AI (Private) ===
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_GENAI_API_KEY=your_google_genai_api_key

# === Supabase (Private Server-Side) ===
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# === Environment Configuration ===
NODE_ENV=production

# === Supabase Client (Public) ===
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Google sign-in (Google Cloud console > APIs & Services > Credentials > OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public address of the app. Google redirects back to APP_URL/api/auth/google/callback
APP_URL=http://localhost:3000
# Random string, 32+ chars. MUST be identical in frontend/.env and backend/.env
SESSION_SECRET=

# --- Email (verification + password reset links). Without SMTP_HOST the link is printed in the server console.
# Gmail example: host smtp.gmail.com, port 587, user = your Gmail, pass = a Google "App password"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="KABS Pricing AI <no-reply@yourdomain.com>"

# --- Built-in Super Admin (KABS). Bypasses public signup; sign in with these
# directly on the normal Sign in tab. Keep this file out of git (it already is).
SUPER_ADMIN_EMAIL=admin@kabs.com
SUPER_ADMIN_PASSWORD=

# --- OpenAI (paid). Paste your key here; never commit this file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
